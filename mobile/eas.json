{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "TON_APPLE_ID@example.com",
        "ascAppId": "REMPLIR_APRES_CREATION_APP_STORE_CONNECT",
        "appleTeamId": "REMPLIR_AVEC_TON_TEAM_ID"
      }
    }
  }
}
